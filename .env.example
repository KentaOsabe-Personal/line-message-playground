MYSQL_DATABASE=line_message
MYSQL_USER=line_message
MYSQL_PASSWORD=line_message_password
MYSQL_ROOT_PASSWORD=root_password
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# 管理画面を開くLINE Mini AppのLIFF ID
VITE_LIFF_ID=
# 上記Mini Appのchannel IDとDeveloping channel secret
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# Mini App、Messaging API channelと共通のprovider ID
LINE_LOGIN_PROVIDER_ID=
# アプリ内に登録した、Mini Appへ紐づくMessaging API channelのpublic UUID
LINE_LIFF_LINKED_CHANNEL_PUBLIC_ID=
# SHA-256("<provider ID>\\0<同一providerのあなたのユーザーID>")
LINE_OWNER_SUBJECT_DIGEST=

# 文章判定ラボ用LINE Mini Appの公開LIFF ID
VITE_TEXT_JUDGMENT_LAB_LIFF_ID=
# ラボは全実装・検証が完了するまでfalseのままにする
TEXT_JUDGMENT_LAB_ENABLED=false
# LINE Developers Consoleに表示されるMini App channel ID
TEXT_JUDGMENT_LAB_CHANNEL_ID=
# SHA-256("<Mini App channel ID>:<同一providerのあなたのユーザーID>")
TEXT_JUDGMENT_LAB_OWNER_DIGEST=
# 末尾slashやpathを含まないHTTPS origin
TEXT_JUDGMENT_LAB_ORIGIN=
# Backendだけへ渡すTypeSafe/Jevの秘密API key
TYPESAFE_API_KEY=
# 判定互換性のため固定。latest等へ変更しない
TEXT_JUDGMENT_LAB_MODEL=jev-1.13.0

LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=
LINE_CHANNEL_CREDENTIAL_KEYS=

LINE_RICH_MENU_MUTATION_MODE=read_only
LINE_RICH_MENU_REFERENCE_PROBE_INTEGRATED=false
LINE_RICH_MENU_HISTORY_PURGE_INTEGRATED=false
LINE_RICH_MENU_DEACTIVATION_LIFECYCLE_INTEGRATED=false
LINE_RICH_MENU_INTEGRATION_MARKER=
